FITWITNESS_DATABASE_URL=postgresql://fitwitness:local-dev-only@localhost:5432/fitwitness
FITWITNESS_SESSION_SECRET=replace-before-hosting
FITWITNESS_ALLOWED_ORIGINS=http://localhost:8787,http://127.0.0.1:8787,http://localhost:5173,http://127.0.0.1:5173
# OPENAI_API_KEY= configure securely, never commit
# ANTHROPIC_API_KEY= configure securely, never commit
# FITWITNESS_OPENAI_MODEL=
# FITWITNESS_OPENAI_INPUT_USD_PER_MILLION=
# FITWITNESS_OPENAI_OUTPUT_USD_PER_MILLION=
# FITWITNESS_ANTHROPIC_MODEL=
# FITWITNESS_ANTHROPIC_INPUT_USD_PER_MILLION=
# FITWITNESS_ANTHROPIC_OUTPUT_USD_PER_MILLION=

# Optional research/operator worker only; keep off on the free demo.
FITWITNESS_ENCODERS=off
FITWITNESS_MODEL_CACHE=var/models
FITWITNESS_TORCH_THREADS=2

# Operator-only optional cross-encoder; requires download_encoders.py --reranker
FITWITNESS_RERANKER=off

# Operator-only VLM region observations. Uncertain facts never establish a match.
FITWITNESS_VISION=off

# Worker processes kept imported and idle so a run starts at once (about 90MB RSS each). Default 1.
# FITWITNESS_WARM_WORKERS=1

# OpenTelemetry: send each finished run's trace to an OTLP/HTTP backend (see docs/OBSERVABILITY.md).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_EXPORTER_OTLP_HEADERS=authorization=Bearer xxx
# FITWITNESS_ENV=local

# Reading scanned claim documents (docs/CLAIMS.md): needs `apt install tesseract-ocr tesseract-ocr-kor`.
# Without the binary a page that has no text layer reads as empty and the claim goes to a reviewer.
# FITWITNESS_TESSERACT=tesseract
# FITWITNESS_OCR_LANG=kor+eng
# FITWITNESS_OCR_THREADS=1

# Reading the title block of an image-only drawing (docs/TITLE-BLOCK.md). On by default when Tesseract is installed.
# FITWITNESS_TITLE_BLOCK_OCR=off
# FITWITNESS_DRAWING_OCR_LANG=chi_sim+kor+eng
# Terminal-style search for the agent (grep/find over a read-only copy of the workspace text). Off by default.
# FITWITNESS_SHELL_SEARCH=off

# Live model reading of a claim in the public demo. Off unless ALL are set; the daily ceiling is the most it can cost
# (docs/DEPLOYMENT.md). FITWITNESS_ANTHROPIC_MODEL and the two prices above are required as well.
# FITWITNESS_LIVE_DEMO=on
# FITWITNESS_LIVE_RUN_USD=0.03
# FITWITNESS_LIVE_DAILY_USD=1.00
# FITWITNESS_LIVE_PER_SESSION=2

# Reviewer identity: with all three set, every answer to a parked run must carry an OpenID Connect ID token
# (Authorization: Bearer), the reviewer is the account it proves and a second approval must be another account
# (docs/DEPLOYMENT.md). Unset (the public demo): the reviewer is the typed name.
# FITWITNESS_OIDC_ISSUER=https://login.example.com/realms/claims
# FITWITNESS_OIDC_AUDIENCE=fitwitness
# FITWITNESS_OIDC_JWKS_URL=https://login.example.com/realms/claims/protocol/openid-connect/certs
# FITWITNESS_OIDC_JWKS_FILE=/etc/fitwitness/jwks.json   # keys from a file instead of the URL; with neither, they come from the issuer's discovery document

# /metrics is closed (401) unless this bearer token is set. Prometheus sends it from deploy/prometheus/metrics-token.
# FITWITNESS_METRICS_TOKEN=replace-with-a-long-random-string

# Connection pool per process (default 8) and how long a parked run waits for a reviewer before senior handling (default 86400).
# FITWITNESS_DB_POOL_MAX=8
# FITWITNESS_REVIEW_TTL_SECONDS=86400

# Per-address cap on new demo workspaces per hour (default 20; the whole demo is capped at 100).
# FITWITNESS_SESSION_LIMIT_PER_PEER=20

# pgvector HNSW search width, raised or lowered for recall versus time (default 400, pgvector allows up to 1000).
# FITWITNESS_HNSW_EF_SEARCH=400

# The deployed commit written into every run (RENDER_GIT_COMMIT on Render; set this elsewhere, e.g. in a container build).
# FITWITNESS_GIT_SHA=
# Version label put into exported traces.
# FITWITNESS_VERSION=

# Where the synthetic claim cases live (default var/claims) and the traces-only OTLP endpoint (alternative to OTEL_EXPORTER_OTLP_ENDPOINT).
# FITWITNESS_CLAIMS_DIR=var/claims
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces

# OCR word merge distance in line heights (default 0.60) for the scanned-claim reader.
# FITWITNESS_OCR_MERGE_GAP=0.60

# Scripts only: the commercial OCR comparison needs the price you agreed to; the demo capture script needs the demo address.
# FITWITNESS_UPSTAGE_USD_PER_PAGE=
# FITWITNESS_DEMO_URL=http://127.0.0.1:8787
# FITWITNESS_API_DOCS=off  # on turns on /docs and /redoc; they load scripts from a public CDN, so leave them off on a closed network
